# Copy to .env for local dev. The app does NOT auto-load this file —
# export the vars in your shell or use a tool like `direnv`.

# Address to bind (host:port). Default: :8080
ADDR=:8080

# SQLite database path. Default: ./sqlite.db
DATABASE_URL=./sqlite.db

# Required. Random 32+ byte string used to sign session cookies.
SESSION_SECRET=

# Required. ESV API key from https://api.esv.org/
ESV_API_KEY=

# Required. YouVersion Platform app key from https://platform.youversion.com/
# (NIV translation, bible_id 111, must have its license accepted in the
# YouVersion console).
YOUVERSION_APP_KEY=

# Set to "dev" for local development over plain HTTP (drops the Secure
# flag on session cookies so they actually persist). Default: prod.
ENV=dev
