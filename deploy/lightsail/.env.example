# Copy to `.env` next to compose.yaml on the host (chmod 600).
# Compose loads this file automatically for ${VAR} substitution.

# --- Image ---
# Pinned image reference, e.g. ghcr.io/<you>/study-help:sha-<git-sha>
# or <account>.dkr.ecr.<region>.amazonaws.com/study-help:sha-<git-sha>.
# Avoid `:latest` so deploys are reproducible and rollbacks unambiguous.
APP_IMAGE=ghcr.io/CHANGEME/study-help:sha-CHANGEME

# --- App secrets ---
ESV_API_KEY=
YOUVERSION_APP_KEY=
